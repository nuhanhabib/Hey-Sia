<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Privacy rule for Sia: she only gets the permissions she truly needs.
        NO access to photos, media, documents, files, accounts or email.
        Permissions are added step by step as features are built.
    -->

    <!-- Step 3 (listening): microphone, so Sia can hear you. Speech is processed on the phone only. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Step 4 (wake word): keep listening for "Hey Sia" in the background, with a visible notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Step 5 (commands):
        - contacts + phone: call people by name (reads names and numbers only)
        - set alarm: set alarms and timers in the Clock app
        - display over other apps: lets the background service open apps, the dialer and the clock
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Step 6 (music):
        - music files: find songs saved on the phone (audio only, never photos/videos/documents)
        - internet + network state: find songs on YouTube, only when you're already online
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A phone without a SIM (or a tablet) can still install Sia. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!--
        Step 2 (voice): no permission needed. Android 11+ hides other apps by default,
        so Sia must declare that she looks for a text-to-speech engine to talk through.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Step 5: see which apps can be opened by name, and find the dialer and clock. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- Step 6: find a music app and the YouTube apps. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <package android:name="app.revanced.android.youtube" />
        <package android:name="com.vanced.android.youtube" />
        <package android:name="com.google.android.youtube" />
        <!-- Step 7: messaging apps. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.facebook.orca" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HeySia">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SiaService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Step 7: taps switches and Send buttons for you, only when you give a command. -->
        <service
            android:name=".a11y.SiaAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
